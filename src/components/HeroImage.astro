---
// Image de bandeau plein écran : déclinée en AVIF/WebP à plusieurs largeurs,
// pour que le mobile ne télécharge pas la photo d'origine (plusieurs Mo).
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}
const { src, alt, class: className } = Astro.props;
const widths = [640, 960, 1280, 1920].filter((w) => w <= src.width);
// Image de repli (navigateurs sans AVIF/WebP) plafonnée à 1920 px de large
const width = Math.min(src.width, 1920);
const height = Math.round((src.height * width) / src.width);
---

<Picture
  src={src}
  alt={alt}
  width={width}
  height={height}
  class={className}
  formats={["avif", "webp"]}
  widths={widths.length ? widths : [src.width]}
  sizes="100vw"
  quality={70}
  loading="eager"
  fetchpriority="high"
/>
