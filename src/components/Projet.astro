---
import { toHTML } from "@portabletext/to-html";
import { urlFor } from "../lib/sanity";
import { toEmbedUrl } from "../lib/video";
import type { Projet } from "../lib/sanity";

interface Props {
  projet: Projet;
}
const { projet } = Astro.props;

const cover = projet.cover ? urlFor(projet.cover)?.width(1920).quality(72).url() : null;
const galerie = (projet.galerie ?? []).filter(Boolean);
const embed = toEmbedUrl(projet.video_url);
const description = projet.description ? toHTML(projet.description) : "";
---

<article>
  <!-- Bandeau projet -->
  <header class="relative flex h-[60vh] min-h-[380px] items-end overflow-hidden bg-[#20221f]">
    {cover && (
      <img
        src={cover}
        alt={projet.titre}
        class="absolute inset-0 h-full w-full object-cover opacity-75"
        fetchpriority="high"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
    <div class="relative z-10 mx-auto w-full max-w-5xl px-6 pb-12 md:px-8">
      {projet.categorie && (
        <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">{projet.categorie}</p>
      )}
      <h1 class="text-3xl font-extrabold uppercase tracking-tight text-white md:text-5xl">
        {projet.titre}
      </h1>
      {(projet.lieu || projet.annee) && (
        <p class="mt-4 text-xs uppercase tracking-[0.15em] text-gray-300">
          {[projet.lieu, projet.annee].filter(Boolean).join(" · ")}
        </p>
      )}
    </div>
  </header>

  <!-- Description (texte riche) -->
  {description && (
    <section class="mx-auto max-w-3xl px-6 py-16 md:py-20">
      <div class="prose-archidia text-base leading-relaxed text-gray-700" set:html={description} />
    </section>
  )}

  <!-- Vidéo (lien YouTube / Vimeo) -->
  {embed && (
    <section class="mx-auto max-w-5xl px-6 pb-16 md:pb-20">
      <div class="relative aspect-video w-full overflow-hidden bg-black">
        <iframe
          src={embed}
          title={`Vidéo — ${projet.titre}`}
          class="absolute inset-0 h-full w-full"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </section>
  )}

  <!-- Galerie -->
  {galerie.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 pb-20 md:pb-28">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {galerie.map((a: any) => (
          <img
            src={urlFor(a)?.width(800).quality(78).url()}
            alt={a.alt || projet.titre}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        ))}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="border-t border-gray-100 px-6 py-16 text-center">
    <a
      href="/realisations"
      class="text-[10px] font-bold uppercase tracking-widest text-gray-400 transition hover:text-accent"
    >
      ← Toutes les réalisations
    </a>
  </section>
</article>
