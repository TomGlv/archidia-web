---
import { CATEGORIES, slugify, urlFor, type ProjetListItem } from "../lib/sanity";

interface Props {
  projet: ProjetListItem;
}
const { projet: p } = Astro.props;

const meta = [p.chiffres, p.lieu, p.annee].filter(Boolean).join(" · ");
const cats = CATEGORIES.filter((c) => p.categories.includes(c.value))
  .map((c) => c.slug)
  .join(" ");
---

<a
  href={`/realisations/${p.slug}`}
  class="projet-card reveal group flex flex-col overflow-hidden border border-gray-200 bg-white transition hover:border-accent"
  data-cats={cats}
  data-secteur={p.secteur ? slugify(p.secteur) : ""}
>
  {p.cover ? (
    <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
      <img
        src={urlFor(p.cover)?.width(800).height(600).quality(78).url()}
        alt={p.cover.alt || p.titre}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="h-1 bg-accent"></div>
  )}
  <div class="flex flex-1 flex-col p-6">
    {p.secteur && (
      <span class="text-[10px] font-black uppercase tracking-widest text-accent">{p.secteur}</span>
    )}
    <h3 class="mt-2 text-lg font-normal uppercase tracking-tight text-anthracite">{p.titre}</h3>
    {meta && <p class="mt-1 text-[11px] font-bold uppercase tracking-widest text-gray-400">{meta}</p>}
    {p.extrait && <p class="mt-4 line-clamp-4 text-sm leading-relaxed text-gray-500">{p.extrait}</p>}
    <div class="mt-auto flex items-center justify-between gap-4 pt-5">
      <span class="text-[10px] font-bold uppercase tracking-widest text-black transition group-hover:translate-x-1 group-hover:text-accent">
        Voir le projet →
      </span>
      {p.avantArchidia && (
        <span class="text-[9px] font-bold uppercase tracking-widest text-gray-400">Parcours antérieur</span>
      )}
    </div>
  </div>
</a>
