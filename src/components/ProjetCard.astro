---
import { CATEGORIES, slugify, srcsetFor, urlFor, type ProjetListItem } from "../lib/sanity";

interface Props {
  projet: ProjetListItem;
  /** Image chargée tout de suite (cartes visibles sans défiler) */
  eager?: boolean;
}
const { projet: p, eager = false } = Astro.props;

// Texte alternatif par défaut : nom, type et lieu du projet
const altCarte = [p.titre, p.secteur, p.lieu].filter(Boolean).join(" — ");

const meta = [p.chiffres, p.lieu, p.annee].filter(Boolean).join(" · ");
const cats = CATEGORIES.filter((c) => p.categories.includes(c.value))
  .map((c) => c.slug)
  .join(" ");
// Étiquette orange « AMO » ou « MOE » selon le type de mission du projet
const mission = p.categories.includes("AMO / MOE") ? p.mission : undefined;
const etiquette = "bg-accent px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-[#fff]";
---

<a
  href={`/realisations/${p.slug}/`}
  class="projet-card reveal group flex flex-col overflow-hidden border border-gray-200 bg-white transition hover:border-accent"
  data-cats={cats}
  data-secteur={p.secteur ? slugify(p.secteur) : ""}
>
  {p.cover ? (
    <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
      <img
        src={urlFor(p.cover)?.width(800).height(600).quality(75).auto("format").url()}
        srcset={srcsetFor(p.cover, [400, 600, 800], 0.75)}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        alt={p.cover.alt || altCarte}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        width="800"
        height="600"
        loading={eager ? "eager" : "lazy"}
      />
      {mission && <span class:list={["absolute left-3 top-3", etiquette]}>{mission}</span>}
    </div>
  ) : (
    <div class="h-1 bg-accent"></div>
  )}
  <div class="flex flex-1 flex-col p-6">
    {mission && !p.cover && <span class:list={["mb-3 self-start", etiquette]}>{mission}</span>}
    {p.secteur && (
      <span class="text-[10px] font-black uppercase tracking-widest text-accent">{p.secteur}</span>
    )}
    <h3 class="titre-3 mt-2 text-anthracite">{p.titre}</h3>
    {meta && <p class="mt-1 text-[11px] font-bold uppercase tracking-widest text-gray-400">{meta}</p>}
    {p.extrait && <p class="mt-4 line-clamp-4 text-sm leading-relaxed text-gray-500">{p.extrait}</p>}
    <div class="mt-auto flex items-center justify-between gap-4 pt-5">
      <span class="text-[10px] font-bold uppercase tracking-widest text-anthracite transition group-hover:translate-x-1 group-hover:text-accent">
        Voir le projet →
      </span>
      {p.avantArchidia && (
        <span class="text-[9px] font-bold uppercase tracking-widest text-gray-400">Parcours antérieur</span>
      )}
    </div>
  </div>
</a>
