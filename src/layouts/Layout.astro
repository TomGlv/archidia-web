---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Image de partage (Open Graph), chemin absolu depuis /public */
  image?: string;
  /** Texte alternatif de l'image de partage */
  imageAlt?: string;
  /** Empêcher l'indexation (ex. page de remerciement) */
  noindex?: boolean;
  /** Fil d'Ariane (hors accueil), pour les données structurées */
  breadcrumbs?: { name: string; path: string }[];
  /** Données structurées schema.org supplémentaires (JSON-LD) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/images/og-default.jpg",
  imageAlt = "ArchidiA — architecture et assistance à maîtrise d'ouvrage",
  noindex = false,
  breadcrumbs = [],
  jsonLd = [],
} = Astro.props;

const siteName = "ArchidiA";
const fullTitle = title.includes("ArchidiA") ? title : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImage = new URL(image, Astro.site ?? Astro.url).href;
const siteUrl = new URL("/", Astro.site ?? Astro.url).href;
const abs = (path: string) => new URL(path, Astro.site ?? Astro.url).href;

// Données structurées schema.org : l'agence (entreprise locale) et le site,
// présents sur toutes les pages, + fil d'Ariane et données propres à la page.
const organisation = {
  "@type": "ProfessionalService",
  "@id": `${siteUrl}#organisation`,
  name: siteName,
  legalName: "ArchidiA",
  description:
    "Agence d'architecture et d'assistance à maîtrise d'ouvrage installée à Bougival (Yvelines), fondée par Claudia Aubert-Paredes, architecte inscrite à l'Ordre des architectes d'Île-de-France, plus de 20 ans d'expérience. AMO et maîtrise d'œuvre (bureaux, hôtels, logements collectifs), DTG et PPPT de copropriétés, construction, extension et rénovation de maisons, adaptation du logement. Interventions dans l'ouest parisien, à Paris et en Île-de-France.",
  url: siteUrl,
  logo: abs("/images/logo.jpg"),
  image: abs("/images/og-default.jpg"),
  email: "claudia.aubert@archidia.fr",
  telephone: "+33614600663",
  address: {
    "@type": "PostalAddress",
    streetAddress: "8, avenue des Fauvettes",
    postalCode: "78380",
    addressLocality: "Bougival",
    addressRegion: "Île-de-France",
    addressCountry: "FR",
  },
  // Coordonnées de l'adresse d'après la Base Adresse Nationale
  geo: { "@type": "GeoCoordinates", latitude: 48.86721, longitude: 2.15226 },
  // Fiche Google Business Profile (lien CID stable, préféré au lien court maps.app.goo.gl)
  hasMap: "https://maps.google.com/?cid=18169346379558239679",
  areaServed: [
    ...[
      "Bougival",
      "Rueil-Malmaison",
      "La Celle-Saint-Cloud",
      "Louveciennes",
      "Croissy-sur-Seine",
      "Saint-Germain-en-Laye",
      "Versailles",
      "Boulogne-Billancourt",
    ].map((name) => ({ "@type": "City", name })),
    { "@type": "AdministrativeArea", name: "Yvelines" },
    { "@type": "AdministrativeArea", name: "Hauts-de-Seine" },
    { "@type": "City", name: "Paris" },
    { "@type": "AdministrativeArea", name: "Île-de-France" },
  ],
  sameAs: [
    "https://www.linkedin.com/in/claudia-aubert-paredes-90141a16",
    "https://www.instagram.com/archidia_architecture",
    "https://maps.google.com/?cid=18169346379558239679",
  ],
  // Les quatre métiers, décrits en détail (Service) sur leurs pages respectives
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Missions ArchidiA",
    itemListElement: ["amo-moe", "diagnostics", "habitats", "autonomie"].map((page) => ({
      "@type": "Offer",
      itemOffered: { "@id": `${siteUrl}${page}/#service` },
    })),
  },
  founder: {
    "@type": "Person",
    "@id": `${siteUrl}a-propos/#claudia`,
    name: "Claudia Aubert-Paredes",
    jobTitle: "Architecte",
    url: abs("/a-propos/"),
    image: abs("/images/claudia.jpg"),
    sameAs: ["https://www.linkedin.com/in/claudia-aubert-paredes-90141a16"],
    hasCredential: {
      "@type": "EducationalOccupationalCredential",
      credentialCategory: "Inscription à l'Ordre des architectes",
      name: "Architecte inscrite à l'Ordre des architectes d'Île-de-France, n° 086701",
      recognizedBy: { "@type": "Organization", name: "Ordre des architectes d'Île-de-France" },
    },
    memberOf: { "@type": "Organization", name: "Architectes & Particuliers" },
  },
  foundingDate: "2019",
  vatID: "FR81878483239",
  identifier: { "@type": "PropertyValue", propertyID: "SIREN", value: "878483239" },
  knowsAbout: [
    "Assistance à maîtrise d'ouvrage (AMO)",
    "Maîtrise d'œuvre (MOE)",
    "Diagnostic technique global (DTG)",
    "Projet de plan pluriannuel de travaux (PPPT)",
    "Rénovation énergétique",
    "Habitat : construction, extension et rénovation",
    "Adaptation du logement",
  ],
};
const website = {
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  url: siteUrl,
  name: siteName,
  inLanguage: "fr-FR",
  publisher: { "@id": `${siteUrl}#organisation` },
};
const breadcrumbList = breadcrumbs.length
  ? {
      "@type": "BreadcrumbList",
      itemListElement: [{ name: "Accueil", path: "/" }, ...breadcrumbs].map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: abs(b.path),
      })),
    }
  : null;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [organisation, website, breadcrumbList, ...[jsonLd].flat()].filter(Boolean),
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <!-- Thème mémorisé appliqué avant l'affichage (évite un flash blanc) -->
    <script is:inline>
      try { if (localStorage.getItem("theme") === "sombre") document.documentElement.classList.add("dark"); } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    <meta name="author" content="Claudia Aubert-Paredes — ArchidiA" />

    <!-- Open Graph / réseaux sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Données structurées (Google, Bing…) -->
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class="text-ink antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Apparition au scroll
      const els = document.querySelectorAll(".reveal");
      if (els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("active");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
