---
import Layout from "../../layouts/Layout.astro";

// Récupération des projets depuis Storyblok (si le CMS est connecté).
// Sans token, la page se construit quand même avec un état « à venir ».
const token = import.meta.env.STORYBLOK_TOKEN;
let projets: any[] = [];

if (token) {
  const { useStoryblokApi } = await import("@storyblok/astro");
  const storyblokApi = useStoryblokApi();
  const { data } = await storyblokApi.get("cdn/stories", {
    version: import.meta.env.PROD ? "published" : "draft",
    content_type: "projet",
    starts_with: "realisations/",
    per_page: 100,
    sort_by: "content.annee:desc",
  });
  projets = data?.stories ?? [];
}

const img = (filename?: string, size = "800x600", q = 78) =>
  filename ? `${filename}/m/${size}/filters:quality(${q})` : "";
---

<Layout
  title="Réalisations — Nos projets"
  description="Découvrez les réalisations d'ArchidiA : AMO/MOE (bureaux, hôtellerie, logements), diagnostics de copropriétés, maisons individuelles et adaptation du logement."
>
  <section class="border-b border-gray-100 px-6 py-20 text-center md:px-8 md:py-28">
    <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">Réalisations</p>
    <h1 class="text-4xl font-extrabold uppercase tracking-tight text-black md:text-6xl">
      Nos projets
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-gray-500">
      Une sélection de projets menés par ArchidiA, de la conception au suivi de chantier.
    </p>
  </section>

  {projets.length > 0 ? (
    <section class="mx-auto max-w-7xl px-6 py-16 md:px-8 md:py-20">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projets.map((p) => {
          const c = p.content;
          return (
            <a href={`/realisations/${p.slug}`} class="reveal group block overflow-hidden border border-gray-200 transition hover:border-accent">
              <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
                {c.cover?.filename && (
                  <img
                    src={img(c.cover.filename)}
                    alt={c.cover.alt || c.titre}
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                )}
              </div>
              <div class="p-6">
                {c.categorie && (
                  <span class="text-[10px] font-black uppercase tracking-widest text-accent">{c.categorie}</span>
                )}
                <h2 class="mt-2 text-lg font-extrabold uppercase tracking-tight text-black">{c.titre}</h2>
                {(c.lieu || c.annee) && (
                  <p class="mt-1 text-xs uppercase tracking-[0.12em] text-gray-400">
                    {[c.lieu, c.annee].filter(Boolean).join(" · ")}
                  </p>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ) : (
    <section class="mx-auto max-w-2xl px-6 py-24 text-center">
      <p class="text-lg text-gray-500">
        Nos réalisations seront présentées ici très prochainement.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-block border-2 border-black px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-black transition hover:bg-black hover:text-white"
      >
        Parlons de votre projet →
      </a>
    </section>
  )}
</Layout>
