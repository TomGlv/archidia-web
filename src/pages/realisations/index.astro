---
import Layout from "../../layouts/Layout.astro";
import ProjetCard from "../../components/ProjetCard.astro";
import { CATEGORIES, getProjets, slugify } from "../../lib/sanity";

const projets = await getProjets();

// Filtres : catégories présentes, et pour chacune ses secteurs (dans l'ordre d'apparition).
const filtres = CATEGORIES.map((c) => {
  const items = projets.filter((p) => p.categories.includes(c.value));
  const secteurs = [...new Set(items.map((p) => p.secteur).filter(Boolean))] as string[];
  return { ...c, total: items.length, secteurs: secteurs.map((s) => ({ label: s, slug: slugify(s) })) };
}).filter((c) => c.total > 0);

const hasAvantArchidia = projets.some((p) => p.avantArchidia);

const chip =
  "filtre border px-4 py-2 text-[10px] font-bold uppercase tracking-widest transition hover:border-black hover:text-black";
---

<Layout
  title="Réalisations — Nos projets"
  description="Découvrez les réalisations d'ArchidiA : AMO/MOE (bureaux, hôtellerie, logements), diagnostics de copropriétés, maisons individuelles et adaptation du logement."
  breadcrumbs={[{ name: "Réalisations", path: "/realisations/" }]}
>
  <section class="border-b border-gray-100 px-6 py-20 text-center md:px-8 md:py-28">
    <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">Réalisations</p>
    <h1 class="text-4xl font-extrabold uppercase tracking-tight text-black md:text-6xl">
      Nos projets
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-gray-500">
      Une sélection de projets menés par ArchidiA, de la conception au suivi de chantier.
    </p>
  </section>

  {projets.length > 0 ? (
    <section class="mx-auto max-w-7xl px-6 py-16 md:px-8 md:py-20">
      <!-- Filtres (fonctionnent via ?cat=…&secteur=… ; sans JS, tout est affiché) -->
      <nav id="filtres" class="mb-12 space-y-4" aria-label="Filtrer les réalisations">
        <div class="flex flex-wrap gap-2">
          <a href="/realisations" data-cat="" class={chip}>Tous · {projets.length}</a>
          {filtres.map((c) => (
            <a href={`/realisations?cat=${c.slug}`} data-cat={c.slug} class={chip}>
              {c.value} · {c.total}
            </a>
          ))}
        </div>
        {filtres.filter((c) => c.secteurs.length > 1).map((c) => (
          <div class="secteurs hidden flex-wrap gap-2" data-for={c.slug}>
            <a href={`/realisations?cat=${c.slug}`} data-cat={c.slug} data-secteur="" class={chip}>
              Tous les secteurs
            </a>
            {c.secteurs.map((s) => (
              <a
                href={`/realisations?cat=${c.slug}&secteur=${s.slug}`}
                data-cat={c.slug}
                data-secteur={s.slug}
                class={chip}
              >
                {s.label}
              </a>
            ))}
          </div>
        ))}
      </nav>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projets.map((p) => <ProjetCard projet={p} />)}
      </div>

      {hasAvantArchidia && (
        <p class="mx-auto mt-16 max-w-3xl text-center text-xs leading-relaxed text-gray-400">
          Les projets marqués « Parcours antérieur » ont été menés avant la création
          d'Archidi<span class="text-accent">A</span> (2019), au sein du parcours de Claudia
          Aubert-Paredes (Artelia, agence Jean Paul Viguier…). Ils sont présentés pour leur
          pertinence avec l'expertise AMO et MOE, mais ne sont pas des missions
          Archidi<span class="text-accent">A</span>.
        </p>
      )}
    </section>
  ) : (
    <section class="mx-auto max-w-2xl px-6 py-24 text-center">
      <p class="text-lg text-gray-500">
        Nos réalisations seront présentées ici très prochainement.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-block border-2 border-black px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-black transition hover:bg-black hover:text-white"
      >
        Parlons de votre projet →
      </a>
    </section>
  )}
</Layout>

<script>
  const nav = document.getElementById("filtres");
  const cards = [...document.querySelectorAll<HTMLElement>(".projet-card")];

  function apply() {
    const params = new URLSearchParams(location.search);
    const cat = params.get("cat") ?? "";
    const secteur = params.get("secteur") ?? "";

    for (const card of cards) {
      const okCat = !cat || (card.dataset.cats ?? "").split(" ").includes(cat);
      const okSecteur = !secteur || card.dataset.secteur === secteur;
      card.hidden = !(okCat && okSecteur);
    }

    nav?.querySelectorAll<HTMLElement>(".secteurs").forEach((row) => {
      row.classList.toggle("hidden", row.dataset.for !== cat);
      row.classList.toggle("flex", row.dataset.for === cat);
    });

    nav?.querySelectorAll<HTMLAnchorElement>(".filtre").forEach((a) => {
      const isSecteurChip = a.dataset.secteur !== undefined;
      const active = isSecteurChip
        ? a.dataset.cat === cat && a.dataset.secteur === secteur
        : a.dataset.cat === cat;
      a.classList.toggle("border-black", active);
      a.classList.toggle("bg-black", active);
      a.classList.toggle("text-white", active);
      a.classList.toggle("border-gray-200", !active);
      a.classList.toggle("text-gray-500", !active);
    });
  }

  // Filtrage sans rechargement, en gardant une URL partageable.
  nav?.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a.filtre");
    if (!a) return;
    e.preventDefault();
    history.replaceState(null, "", a.href);
    apply();
  });

  apply();
</script>
