---
import Layout from "../../layouts/Layout.astro";
import Projet from "../../storyblok/Projet.astro";

export async function getStaticPaths() {
  const token = import.meta.env.STORYBLOK_TOKEN;
  if (!token) return []; // Pas de token → aucune page projet générée pour l'instant.

  const { useStoryblokApi } = await import("@storyblok/astro");
  const storyblokApi = useStoryblokApi();
  const { data } = await storyblokApi.get("cdn/stories", {
    version: import.meta.env.PROD ? "published" : "draft",
    content_type: "projet",
    starts_with: "realisations/",
    per_page: 100,
  });

  return (data?.stories ?? []).map((story: any) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const c = story.content;

// Description courte pour le SEO (texte brut extrait du richtext si dispo).
const desc =
  c.meta_description ||
  `${c.titre}${c.lieu ? " — " + c.lieu : ""} : projet réalisé par ArchidiA (architecture & AMO).`;
const ogImage = c.cover?.filename
  ? `${c.cover.filename}/m/1200x630/filters:quality(80)`
  : undefined;
---

<Layout title={`${c.titre} — Réalisations`} description={desc} image={ogImage}>
  <Projet blok={c} />
</Layout>
