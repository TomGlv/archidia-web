---
import Layout from "../../layouts/Layout.astro";
import Projet from "../../components/Projet.astro";
import { getProjets, getProjet, urlFor } from "../../lib/sanity";

export async function getStaticPaths() {
  const projets = await getProjets();
  return projets.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const projet = await getProjet(slug!);

if (!projet) {
  return Astro.redirect("/realisations");
}

const desc =
  projet.meta_description ||
  `${projet.titre}${projet.lieu ? " — " + projet.lieu : ""} : projet réalisé par ArchidiA (architecture & AMO).`;
const ogImage = projet.cover
  ? urlFor(projet.cover)?.width(1200).height(630).quality(80).url() ?? undefined
  : undefined;
---

<Layout title={`${projet.titre} — Réalisations`} description={desc} image={ogImage}>
  <Projet projet={projet} />
</Layout>
