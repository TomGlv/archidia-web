---
import Layout from "../layouts/Layout.astro";

// Frise du processus — étapes chronologiques d'un projet de maison individuelle
const steps = [
  {
    idx: "01",
    title: "La visite conseil",
    text: "Nos visites conseil s'adressent aux particuliers souhaitant obtenir un premier avis éclairé sur leur projet, pour une durée d'une heure à une heure et demie selon le type de besoin exprimé.",
    livrable: "Rapport selon demande",
    prix: "à partir de 180 € HT",
  },
  {
    idx: "02",
    title: "Les études préliminaires",
    text: "Relevé du site, faisabilité, diagnostic, esquisses présentant plusieurs partis pris possibles, premières visualisations.",
    livrable: "Esquisses",
  },
  {
    idx: "03",
    title: "L'avant-projet",
    text: "Réalisation des plans, coupes et façades avec les dimensions de l'ouvrage, selon la solution retenue, aspect, surfaces et nature des matériaux.",
    livrable: "Dossiers plans d'avant-projet",
  },
  {
    idx: "04",
    title: "Les autorisations d'urbanisme",
    text: "Constitution et dépôt du dossier de permis de construire ou de déclaration préalable, démarches auprès des services concernés.",
    livrable: "Dossier déposé & suivi de l'instruction",
  },
  {
    idx: "05",
    title: "La conception détaillée",
    text: "Choix des matériaux et finitions, plans d'exécution, coupes et façades, pièces techniques nécessaires à la consultation des entreprises.",
    livrable: "Dossier de consultation des entreprises",
  },
  {
    idx: "06",
    title: "Le suivi de chantier",
    text: "Consultation et choix des entreprises, suivi hebdomadaire du chantier, contrôle qualité et budgétaire, jusqu'à la réception des travaux.",
    livrable: "Comptes rendus & réception des travaux",
  },
];

// Réalisations — constructions, extensions, rénovations
const constructions = [
  {
    title: "Maison Bougival",
    meta: "Construction & restructuration de façade · Véranda · 2024 · Bougival",
    text: "Une maison construite en 1974, avec une toiture en ardoise, pensée autour de la transparence et de l'ouverture sur le jardin. Le projet intègre le volume de la véranda pour créer une continuité des façades et de la toiture ; côté Sud, la modification d'une baie existante et la création de deux baies, conservant la largeur d'origine, dessinent une forme fine et élancée qui épouse les lignes de la toiture et apporte de la lumière à la pièce de vie.",
  },
];

const renovations = [
  {
    title: "Buzenval / Rueil-Malmaison",
    meta: "Restructuration de façade et des espaces de vie · 200 m² · Chantier janvier 2026 · Rueil-Malmaison",
    text: "La maison existante, construite en 1940, présente une façade longue de 26,50 m, résultat du rassemblement de plusieurs petites maisons de l'époque. Le projet restructure l'espace de vie — cuisine, salle à manger, salon et salle de piano — avec le déplacement des poteaux existants vers la façade pour dégager la pièce et laisser entrer la lumière, à travers la création de deux verrières et de deux portes-fenêtres. Toutes les menuiseries extérieures et les volets sont en cours de changement.",
  },
  {
    title: "Maison Boulogne-Billancourt",
    meta: "Avant-projet · Isolation thermique par l'extérieur · 2025 · Boulogne-Billancourt",
    text: "Une maison de 1936 (surélevée en 1993) en zone inondable, dont l'isolation thermique par l'extérieur — fibre de bois et enduit minéral — est à l'étude sur tous les étages sauf le rez-de-chaussée. La véranda existante sera conservée, les baies traitées avec des modénatures, et la façade reprise dans des tonalités de gris.",
  },
  {
    title: "Maison Varengeville",
    meta: "Réaménagement d'un sous-sol semi-enterré · 50 m² · Livraison 2021 · Varengeville-sur-Mer",
    text: "Le réaménagement d'un sous-sol semi-enterré, au sein d'une demeure construite en 1936 au-dessus d'une falaise, qui logeait jusqu'alors une salle de billard et l'ensemble des équipements techniques de la maison. L'objectif était de regrouper la chaudière et le chauffe-eau dans un seul local, pour libérer un maximum de surface côté façades et profiter de la lumière naturelle dans les pièces à vivre — avec, entre le local technique et la chambre voisine, un passage secret dissimulé dans la cloison acoustique. Le programme prévoyait deux chambres, une kitchenette et une salle de bain, sans modification structurelle de la maison.",
  },
  {
    title: "Appartement New Hall",
    meta: "Rénovation & réaménagement d'un garage en habitation · 46 m² · Livraison mars 2022 · New Hall, Californie, États-Unis",
    text: "La création d'un appartement indépendant à l'emplacement d'un garage existant, au sein d'une maison californienne de 200 m² — chambre, walking-closet, salle d'eau, cuisine et salon, privilégiant la lumière naturelle et des matériaux nobles. Un projet à l'anecdote singulière, mené à distance depuis la France, qui illustre la capacité d'ArchidiA à suivre un projet en dehors de sa zone d'intervention habituelle.",
  },
  {
    title: "Maison Denise",
    meta: "Restructuration de deux logements · 180 m² · 2020 · Régusse, Haut Var",
    text: "La maison était abandonnée depuis 20 ans et se trouvait dans un état délabré : elle était composée de deux logements imbriqués entre eux. Trois planchers ont été démolis, ainsi qu'une citerne au sous-sol. Lors de la démolition, un volume important a été découvert entre la toiture et le faux-plafond, ce qui a permis de créer une mezzanine et des espaces plus lumineux.",
  },
];
---

<Layout
  title="Maisons individuelles"
  description="Construction de maison individuelle, rénovation et extension : maîtrise d'œuvre et suivi de chantier de A à Z, de la visite conseil à la réception des travaux."
>
  <!-- HERO DE SECTION -->
  <header class="relative flex h-[62vh] min-h-[400px] items-center justify-center overflow-hidden bg-[#20221f]">
    <img
      src="/images/home-intro.jpg"
      alt="Projet de maison individuelle accompagné par ArchidiA"
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/30"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <p class="mb-5 text-[10px] font-bold uppercase tracking-[0.4em] text-accent">
        Maisons individuelles
      </p>
      <h1 class="mb-6 text-4xl font-extrabold uppercase leading-[1.05] tracking-tight text-white drop-shadow-lg sm:text-5xl md:text-6xl">
        Construire, agrandir,<br />rénover.
      </h1>
      <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-gray-300 md:text-xs">
        Constructions · Extensions · <span class="text-accent">Rénovations</span>
      </p>
    </div>
  </header>

  <!-- INTRO -->
  <section class="mx-auto max-w-3xl px-6 py-20 text-center md:py-28">
    <p class="reveal text-xl leading-relaxed text-gray-700 md:text-2xl">
      Ce sont des <span class="font-semibold text-black">projets de vie</span>, pas
      seulement des chantiers.
    </p>
    <p class="reveal mt-6 text-base leading-relaxed text-gray-500 md:text-lg">
      Chaque maison a une histoire — celle d'une famille qui s'agrandit, d'un lieu
      qui se transforme, d'un regard neuf porté sur un espace déjà habité.
    </p>
  </section>

  <!-- FRISE DU PROCESSUS -->
  <section class="border-t border-gray-100 bg-[#fafafa] px-6 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-14 text-center md:mb-20">
        <p class="reveal mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
          Notre méthode
        </p>
        <h2 class="reveal text-3xl font-extrabold uppercase tracking-tight text-black md:text-4xl">
          Le déroulé d'un projet,<br class="hidden sm:block" /> étape par étape
        </h2>
      </div>

      <!-- Timeline : verticale sur mobile, colonne rythmée par l'accent -->
      <ol class="relative mx-auto max-w-4xl">
        <!-- Ligne verticale continue -->
        <span
          class="absolute left-[19px] top-2 bottom-2 w-px bg-gray-200 md:left-1/2 md:-translate-x-1/2"
          aria-hidden="true"></span>

        {steps.map((s, i) => (
          <li
            class:list={[
              "reveal relative mb-10 last:mb-0 pl-14 md:w-1/2 md:pl-0",
              i % 2 === 0
                ? "md:mr-auto md:pr-12 md:text-right"
                : "md:ml-auto md:pl-12",
            ]}
          >
            <!-- Pastille numérotée -->
            <span
              class:list={[
                "absolute top-0 flex h-10 w-10 items-center justify-center rounded-full bg-accent text-xs font-black text-white shadow-md",
                "left-0",
                i % 2 === 0
                  ? "md:left-auto md:-right-5"
                  : "md:-left-5",
              ]}
            >
              {s.idx}
            </span>

            <div class="border-l-4 border-accent bg-white p-6 shadow-sm md:border-l-0 md:border-t-4">
              <span class="block text-[10px] font-bold uppercase tracking-[0.25em] text-gray-400">
                Étape {s.idx}
              </span>
              <h3 class="mt-2 text-lg font-extrabold uppercase tracking-tight text-black">
                {s.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-gray-500">{s.text}</p>
              <p class="mt-4 text-[11px] font-bold uppercase tracking-widest text-black">
                Livrable · <span class="text-accent">{s.livrable}</span>
              </p>
              {s.prix && (
                <p class="mt-1 text-[11px] font-bold uppercase tracking-widest text-gray-400">
                  {s.prix}
                </p>
              )}
            </div>
          </li>
        ))}

        <!-- Point d'arrivée -->
        <li class="reveal relative pl-14 md:mx-auto md:w-full md:pl-0 md:text-center">
          <span
            class="absolute left-0 top-1 flex h-10 w-10 items-center justify-center rounded-full border-2 border-accent bg-white text-accent shadow-md md:left-1/2 md:-translate-x-1/2"
            aria-hidden="true"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/></svg>
          </span>
          <div class="md:pt-14">
            <span class="block text-[10px] font-bold uppercase tracking-[0.25em] text-gray-400 md:mt-0">
              Point d'arrivée
            </span>
            <h3 class="mt-2 text-xl font-extrabold uppercase tracking-tight text-black">
              Votre nouvelle maison
            </h3>
          </div>
        </li>
      </ol>

      <p class="reveal mx-auto mt-14 max-w-2xl text-center text-sm leading-relaxed text-gray-500">
        Hors visite conseil, chaque étape fait l'objet d'un devis à la demande,
        établi sur une base de <span class="font-semibold text-black">800 € HT/jour</span>.
      </p>
    </div>
  </section>

  <!-- CONSTRUCTIONS & EXTENSIONS -->
  <section class="mx-auto max-w-7xl px-6 py-20 md:px-8 md:py-24">
    <p class="reveal mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
      Constructions & extensions
    </p>
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <!-- PHOTO: réalisation Maison Bougival (construction / véranda) -->
      <div class="reveal relative aspect-[4/3] overflow-hidden bg-[#20221f]">
        <img
          src="/images/hero-home.jpg"
          alt="Construction et extension d'une maison individuelle"
          class="h-full w-full object-cover opacity-90"
          loading="lazy"
          width="1200"
          height="900"
        />
      </div>
      {constructions.map((p) => (
        <div class="reveal">
          <h3 class="text-2xl font-extrabold uppercase tracking-tight text-black md:text-3xl">
            {p.title}
          </h3>
          <p class="mt-3 text-[11px] font-bold uppercase tracking-widest text-accent">
            {p.meta}
          </p>
          <p class="mt-5 text-base leading-relaxed text-gray-500">{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- RÉNOVATIONS & RÉAMÉNAGEMENTS -->
  <section class="border-t border-gray-100 bg-[#fafafa] px-6 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <p class="reveal mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
        Rénovations & réaménagements
      </p>
      <h2 class="reveal mb-12 text-3xl font-extrabold uppercase tracking-tight text-black md:text-4xl">
        Redonner vie<br class="hidden sm:block" /> à l'existant
      </h2>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {renovations.map((p) => (
          <article class="reveal flex flex-col border-t-4 border-accent bg-white p-7 shadow-sm">
            <h3 class="text-lg font-extrabold uppercase tracking-tight text-black">
              {p.title}
            </h3>
            <p class="mt-2 text-[10px] font-bold uppercase tracking-widest text-gray-400">
              {p.meta}
            </p>
            <p class="mt-4 text-sm leading-relaxed text-gray-500">{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA CONTACT -->
  <section class="mx-auto max-w-7xl px-6 py-24 text-center md:px-8">
    <h2 class="reveal text-3xl font-extrabold uppercase tracking-tight text-black md:text-4xl">
      Un projet de maison ?
    </h2>
    <p class="reveal mx-auto mt-5 max-w-xl text-base leading-relaxed text-gray-500">
      De la première esquisse au suivi de chantier, l'agence vous accompagne à
      chaque étape de votre projet.
    </p>
    <a
      href="/contact"
      class="reveal mt-8 inline-block border-2 border-black px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-black transition hover:bg-black hover:text-white"
    >
      Parlons de votre projet →
    </a>
  </section>
</Layout>
