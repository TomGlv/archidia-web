---
import Layout from "../layouts/Layout.astro";

const pages = [
  { href: "/amo-moe/", label: "AMO & MOE" },
  { href: "/diagnostics/", label: "Diagnostics & Copropriétés" },
  { href: "/habitats/", label: "Habitats" },
  { href: "/autonomie/", label: "Autonomie" },
  { href: "/realisations/", label: "Réalisations" },
  { href: "/contact/", label: "Contact" },
];
---

<Layout
  title="Page introuvable"
  description="Cette page n'existe pas ou a été déplacée."
  noindex={true}
>
  <section class="mx-auto max-w-3xl px-6 py-16 text-center md:py-24">
    <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">Erreur 404</p>
    <h1 class="titre-1 text-anthracite">Page introuvable</h1>
    <p class="mt-6 text-base leading-relaxed text-gray-500 md:text-lg">
      Cette page n'existe pas ou a été déplacée. Voici les principales rubriques du site :
    </p>
    <nav class="mt-10 flex flex-wrap justify-center gap-3" aria-label="Rubriques du site">
      {pages.map((p) => (
        <a
          href={p.href}
          class="inline-flex min-h-11 items-center border-2 border-anthracite px-6 text-[10px] font-bold uppercase tracking-widest text-anthracite transition hover:bg-anthracite hover:text-white"
        >
          {p.label}
        </a>
      ))}
    </nav>
    <a href="/" class="mt-10 inline-flex min-h-11 items-center text-[11px] font-bold uppercase tracking-widest text-accent">
      ← Retour à l'accueil
    </a>
  </section>
</Layout>
