---
import Layout from "../layouts/Layout.astro";

const blocks = [
  {
    title: "Éditeur du site",
    rows: [
      ["Raison sociale", "ArchidiA — SASU d'architecture"],
      ["Représentante", "Claudia Aubert-Paredes, architecte"],
      ["Adresse", "8, av. des Fauvettes, 78380 Bougival"],
      ["Téléphone", "06 14 60 06 63"],
      ["Email", "claudia.aubert@archidia.fr"],
    ],
  },
  {
    title: "Architecte",
    rows: [
      ["Ordre des architectes", "Tableau de l'Ordre des architectes d'Île-de-France, inscrite depuis le 10/09/2019 - n° S21000"],
      ["Assurance", "N° police assurance MAF : 168786/B"],
    ],
  },
  {
    title: "SASU d'architecture",
    rows: [
      ["RCS / SIREN", "RCS Versailles n° 878 483 239"],
      ["APE / Capital", "APE 7111Z · Capital de 5 000 €"],
      ["N° TVA", "TVA intracommunautaire FR81 878 483 239"],
    ],
  },
  {
    title: "Réseaux sociaux",
    rows: [
      ["LinkedIn", "linkedin.com/in/claudia-aubert-paredes-90141a16", "https://www.linkedin.com/in/claudia-aubert-paredes-90141a16"],
    ],
  },
  {
    title: "Hébergement",
    rows: [
      ["Hébergeur", "Netlify, Inc."],
      ["Adresse", "512 2nd Street, Suite 200, San Francisco, CA 94107, USA"],
    ],
  },
];
---

<Layout
  title="Mentions légales — ArchidiA"
  description="Mentions légales du site ArchidiA — architecture et assistance à maîtrise d'ouvrage, Bougival (78)."
  noindex={true}
>
  <section class="mx-auto max-w-3xl px-6 py-12 md:py-12">
    <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">Mentions</p>
    <h1 class="text-3xl font-normal uppercase tracking-tight text-anthracite md:text-5xl">
      Informations légales
    </h1>

    <div class="mt-8 space-y-12">
      {blocks.map((b) => (
        <div class="reveal">
          <h2 class="mb-5 border-l-4 border-accent pl-4 text-sm font-normal uppercase tracking-widest text-anthracite">
            {b.title}
          </h2>
          <dl class="divide-y divide-gray-100">
            {b.rows.map(([k, v, href]) => (
              <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-[220px_1fr] sm:gap-4">
                <dt class="text-[11px] font-bold uppercase tracking-widest text-gray-400">{k}</dt>
                <dd class="text-sm text-gray-700">
                  {href ? <a href={href} target="_blank" rel="noopener" class="transition hover:text-accent">{v}</a> : v}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      ))}

      <div class="reveal">
        <h2 class="mb-5 border-l-4 border-accent pl-4 text-sm font-normal uppercase tracking-widest text-anthracite">
          Propriété intellectuelle
        </h2>
        <p class="text-sm leading-relaxed text-gray-600">
          L'ensemble des contenus (textes, images, photographies, logo) présents sur
          ce site est la propriété exclusive d'ArchidiA, sauf mention contraire. Toute
          reproduction, même partielle, est interdite sans autorisation préalable.
        </p>
      </div>
    </div>
  </section>
</Layout>
