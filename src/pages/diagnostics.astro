---
import Layout from "../layouts/Layout.astro";
import ReferencesParLigne from "../components/ReferencesParLigne.astro";
import { getLigne, lienRealisations, type ProjetListItem } from "../lib/sanity";
import HeroImage from "../components/HeroImage.astro";
import heroDiagnostics from "../assets/hero-diagnostics.jpg";

// Nos réalisations : 3 projets par type de mission, d'après le secteur saisi
// dans Sanity (« Copropriétés (PPPT) », « Copropriétés (DTG) », « … (DAE) »).
const CAT = "Diagnostics & Copropriétés";
const aLeSigle = (sigle: string) => (p: ProjetListItem) =>
  new RegExp(`\\b${sigle}\\b`).test(p.secteur ?? "");
const types = [
  { sigle: "PPPT", libelle: "Projet de plan pluriannuel de travaux", test: aLeSigle("PPPT") },
  { sigle: "DTG", libelle: "Diagnostic technique global", test: aLeSigle("DTG") },
  { sigle: "DAE", libelle: "Diagnostic architectural & énergétique", test: aLeSigle("DAE") },
];
const references = await Promise.all(
  types.map(async ({ test, ...t }) => {
    const projets = await getLigne(CAT, test);
    return { ...t, projets, href: lienRealisations(CAT, projets[0]?.secteur) };
  }),
);

// Certifications & référencements
const certifications = [
  { nom: "Inscrit à l'Ordre des architectes", logo: "/images/logos/ordre-architectes.webp" },
  { nom: "CoachCopro", logo: "/images/logos/coachcopro.webp" },
  { nom: "Pass'Réno Habitat", logo: "/images/logos/pass-reno-habitat.webp" },
  { nom: "Adhérent Architectes & Particuliers", logo: "/images/logos/architectes-particuliers.webp" },
];
---

<Layout
  title="DTG et PPPT de copropriété – Yvelines & Paris | ArchidiA"
  description="Architecte pour le DTG et le PPPT de votre copropriété, et diagnostics de maisons (DAE) : à Paris, dans les Yvelines et les Hauts-de-Seine. 800 € HT/jour."
  breadcrumbs={[{ name: "Diagnostics & Copropriétés", path: "/diagnostics/" }]}
  jsonLd={{
    "@type": "Service",
    "@id": "https://archidia.fr/diagnostics/#service",
    name: "Diagnostics de copropriétés (DTG, PPPT, DAE)",
    description: "Diagnostic technique global (DTG), projet de plan pluriannuel de travaux (PPPT) pour les copropriétés, et diagnostic architectural et énergétique (DAE) des maisons et petits collectifs.",
    serviceType: "Diagnostics & Copropriétés",
    provider: { "@id": "https://archidia.fr/#organisation" },
    areaServed: [
      { "@type": "City", name: "Paris" },
      { "@type": "AdministrativeArea", name: "Yvelines" },
      { "@type": "AdministrativeArea", name: "Hauts-de-Seine" },
      { "@type": "AdministrativeArea", name: "Île-de-France" },
    ],
    url: "https://archidia.fr/diagnostics/",
  }}
>
  <!-- HERO -->
  <header class="theme-fixe relative flex h-[52vh] min-h-[360px] items-center overflow-hidden bg-[#20221f]">
    <HeroImage
      src={heroDiagnostics}
      alt="Diagnostics techniques et copropriétés ArchidiA"
      class="absolute inset-0 h-full w-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/20"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 md:px-8">
      <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.35em] text-accent">
        Diagnostics & Copropriétés
      </p>
      <h1 class="titre-1 max-w-4xl text-white drop-shadow-lg">
        Diagnostics techniques & accompagnement des copropriétés
      </h1>
      <p class="mt-5 text-[10px] font-bold uppercase tracking-[0.4em] text-gray-300 md:text-xs">
        Copropriétés · <span class="text-accent">PPPT · DTG · DAE</span>
      </p>
    </div>
  </header>

  <!-- INTRO -->
  <section class="mx-auto max-w-3xl px-6 py-12 text-center md:py-12">
    <p class="reveal mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
      Notre expertise
    </p>
    <p class="reveal text-lg leading-relaxed text-anthracite md:text-xl">
      Formée à la rénovation énergétique, <span class="font-semibold text-anthracite">Claudia Aubert-Paredes</span>{" "}
      a élargi son champ d'intervention aux diagnostics techniques et à l'accompagnement des copropriétés.
    </p>
    <p class="reveal mt-6 text-base leading-relaxed text-gray-500 md:text-lg">
      <span class="font-semibold text-anthracite"><span class="text-accent">A</span>rchidi<span class="text-accent">A</span></span> accompagne
      les copropriétés et leurs syndics sur des missions de Diagnostic Technique Global (DTG) et de Projet
      de Plan Pluriannuel de Travaux (PPPT), ainsi que les maisons individuelles et les petits collectifs
      sur des missions de diagnostics architecturaux et énergétiques (DAE).
    </p>
  </section>

  <!-- LES TROIS MISSIONS EXPLIQUÉES -->
  <section class="border-t border-gray-100 bg-gray-50 px-6 py-12 md:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="titre-2 reveal mb-8 text-anthracite">PPPT, DTG, DAE : quel diagnostic pour quel bâtiment ?</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <article class="reveal flex flex-col border border-gray-200 bg-white p-6">
          <h3 class="titre-3 mb-3 text-anthracite"><span class="text-accent">PPPT</span> · Plan pluriannuel de travaux</h3>
          <p class="text-sm leading-relaxed text-gray-600">
            Obligatoire depuis la loi Climat et Résilience pour les copropriétés d'habitation de plus de
            15 ans — y compris, depuis le 1<sup>er</sup> janvier 2025, celles de 50 lots ou moins. Il liste
            et chiffre les travaux à mener sur dix ans, dont la rénovation énergétique.
          </p>
          <a href="/diagnostics/pppt/" class="mt-auto inline-flex min-h-11 items-center pt-4 text-[11px] font-bold uppercase tracking-widest text-accent">Le PPPT expliqué →</a>
        </article>
        <article class="reveal flex flex-col border border-gray-200 bg-white p-6">
          <h3 class="titre-3 mb-3 text-anthracite"><span class="text-accent">DTG</span> · Diagnostic technique global</h3>
          <p class="text-sm leading-relaxed text-gray-600">
            Un état complet de l'immeuble : parties communes, équipements, obligations réglementaires,
            performance énergétique et travaux nécessaires. Il est soumis au vote de l'assemblée générale
            et peut dispenser du PPPT s'il ne révèle aucun besoin de travaux sur dix ans.
          </p>
          <a href="/diagnostics/dtg/" class="mt-auto inline-flex min-h-11 items-center pt-4 text-[11px] font-bold uppercase tracking-widest text-accent">Le DTG expliqué →</a>
        </article>
        <article class="reveal flex flex-col border border-gray-200 bg-white p-6">
          <h3 class="titre-3 mb-3 text-anthracite"><span class="text-accent">DAE</span> · Diagnostic architectural &amp; énergétique</h3>
          <p class="text-sm leading-relaxed text-gray-600">
            Pour une maison ou un petit collectif : visite du bâti, repérage des désordres et des déperditions,
            puis scénarios de travaux hiérarchisés. Une base solide avant une rénovation énergétique ou une
            demande d'aides.
          </p>
          <a href="/contact/" class="mt-auto inline-flex min-h-11 items-center pt-4 text-[11px] font-bold uppercase tracking-widest text-accent">Demander un DAE →</a>
        </article>
      </div>
      <p class="reveal mt-8 max-w-3xl text-base leading-relaxed text-gray-600">
        Copropriétés suivies à Paris (5<sup>e</sup>, 13<sup>e</sup>, 14<sup>e</sup>, 15<sup>e</sup>, 19<sup>e</sup>),
        à Bougival ou à Franconville ; maisons diagnostiquées à Rueil-Malmaison, Boulogne-Billancourt, Sèvres
        ou Ville-d'Avray : les références ci-dessous montrent des missions menées pour des syndics, des
        conseils syndicaux et des particuliers.
      </p>
    </div>
  </section>

  <!-- NOS RÉFÉRENCES : une ligne par type de mission -->
  <ReferencesParLigne titre="Nos réalisations" lignes={references} />

  <!-- HONORAIRES -->
  <section class="mx-auto max-w-7xl px-6 py-12 md:px-8">
    <p class="reveal mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
      Honoraires
    </p>
    <p class="reveal max-w-3xl text-base leading-relaxed text-gray-500 md:text-lg">
      Nos honoraires pour les diagnostics et études de faisabilité sont établis sur la base d'un{" "}
      <span class="font-semibold text-anthracite">tarif journalier de 800 € HT</span>, dont le montant final
      est déterminé selon le type de bien et la taille du bien.
    </p>
  </section>

  <!-- CERTIFICATIONS & PARTENAIRES -->
  <section class="border-t border-gray-100 bg-gray-50 px-6 py-12 md:px-8">
    <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-2">
      <div class="reveal rounded-md border border-gray-200 bg-white p-8">
        <p class="mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
          Certification / référencement
        </p>
        <ul class="grid grid-cols-2 gap-6">
          {certifications.map((c) => (
            <li class="flex flex-col items-start gap-3">
              <span class="flex h-11 items-center rounded bg-[#fff] px-2 py-1">
                <img src={c.logo} alt={c.nom} class="max-h-9 w-auto max-w-full object-contain" loading="lazy" />
              </span>
              <span class="text-sm font-semibold text-anthracite">{c.nom}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal rounded-md border border-gray-200 bg-white p-8">
        <p class="mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
          Partenaires & qualifications
        </p>
        <ul class="space-y-6">
          <li class="flex flex-col items-start gap-3">
            <span class="flex h-11 items-center rounded bg-[#fff] px-2 py-1">
              <img src="/images/logos/tribu-energie.webp" alt="Tribu Énergie" class="max-h-9 w-auto object-contain" loading="lazy" />
            </span>
            <span class="text-sm font-semibold text-anthracite">Tribu Énergie</span>
          </li>
          <li class="flex items-start gap-3 text-sm font-semibold text-anthracite">
            <span class="mt-1.5 block h-1.5 w-1.5 flex-none bg-accent"></span>
            Qualifications OPQIBI et RGE
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA CONTACT -->
  <section class="mx-auto max-w-7xl px-6 py-12 text-center md:px-8">
    <p class="reveal mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
      Un diagnostic à réaliser ?
    </p>
    <p class="reveal mx-auto mb-8 max-w-xl text-base leading-relaxed text-gray-500">
      Indiquez le nombre de lots, l'année de construction et l'adresse de l'immeuble :
      nous vous adressons une proposition d'honoraires.
    </p>
    <a
      href="/contact/"
      class="reveal inline-block bg-anthracite px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-white transition hover:bg-accent"
    >
      Parlons de votre projet →
    </a>
  </section>
</Layout>
