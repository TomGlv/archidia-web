---
import Layout from "../layouts/Layout.astro";
import ReferencesParLigne from "../components/ReferencesParLigne.astro";
import { getLigne, lienRealisations, type ProjetListItem } from "../lib/sanity";

// Nos références : 3 projets par type de mission. Le type est déduit du
// secteur (DAE) ou de la description du projet dans Sanity (PPPT / DTG).
const CAT = "Diagnostics & Copropriétés";
const texte = (p: ProjetListItem) => `${p.secteur ?? ""} ${p.extrait ?? ""}`;
const types = [
  { sigle: "PPPT", libelle: "Projet de plan pluriannuel de travaux", test: (p: ProjetListItem) => /pluriannuel|PPPT/i.test(p.extrait ?? "") },
  { sigle: "DTG", libelle: "Diagnostic technique global", test: (p: ProjetListItem) => /Diagnostic Technique Global|\bDTG\b/i.test(p.extrait ?? "") },
  { sigle: "DAE", libelle: "Diagnostic architectural & énergétique", test: (p: ProjetListItem) => /\bDAE\b/.test(texte(p)) },
];
const references = await Promise.all(
  types.map(async ({ test, ...t }) => {
    const projets = await getLigne(CAT, test);
    return { ...t, projets, href: lienRealisations(CAT, projets[0]?.secteur) };
  }),
);

// Certifications & référencements
const certifications = [
  { nom: "Inscrit à l'Ordre des architectes", logo: "/images/logos/ordre-architectes.webp" },
  { nom: "CoachCopro", logo: "/images/logos/coachcopro.webp" },
  { nom: "Pass'Réno Habitat", logo: "/images/logos/pass-reno-habitat.webp" },
  { nom: "Adhérent Architectes & Particuliers", logo: "/images/logos/architectes-particuliers.webp" },
];
---

<Layout
  title="Diagnostics & Copropriétés"
  description="Diagnostic technique global (DTG), projet de plan pluriannuel de travaux (PPPT) et diagnostic architectural et énergétique (DAE) : ArchidiA accompagne copropriétés et particuliers."
  breadcrumbs={[{ name: "Diagnostics & Copropriétés", path: "/diagnostics/" }]}
  jsonLd={{
    "@type": "Service",
    name: "Diagnostics de copropriétés (DTG, PPPT, DAE)",
    serviceType: "Diagnostics & Copropriétés",
    provider: { "@id": "https://archidia.fr/#organisation" },
    areaServed: { "@type": "AdministrativeArea", name: "Île-de-France" },
    url: "https://archidia.fr/diagnostics/",
  }}
>
  <!-- HERO -->
  <header class="relative flex h-[52vh] min-h-[360px] items-center overflow-hidden bg-[#20221f]">
    <img
      src="/images/hero-home.jpg"
      alt="Diagnostics techniques et copropriétés ArchidiA"
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/20"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 md:px-8">
      <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.35em] text-accent">
        Diagnostics & Copropriétés
      </p>
      <h1 class="max-w-3xl text-3xl font-normal uppercase leading-[1.1] tracking-tight text-white drop-shadow-lg sm:text-4xl md:text-5xl">
        Diagnostics techniques & accompagnement des copropriétés
      </h1>
      <p class="mt-5 text-[10px] font-bold uppercase tracking-[0.4em] text-gray-300 md:text-xs">
        Copropriétés · <span class="text-accent">PPPT · DTG · DAE</span>
      </p>
    </div>
  </header>

  <!-- INTRO -->
  <section class="mx-auto max-w-3xl px-6 py-12 text-center md:py-12">
    <p class="reveal mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
      Notre expertise
    </p>
    <p class="reveal text-lg leading-relaxed text-gray-700 md:text-xl">
      Formée à la rénovation énergétique, <span class="font-semibold text-black">Claudia Aubert-Paredes</span>{" "}
      a élargi son champ d'intervention aux diagnostics techniques et à l'accompagnement des copropriétés.
    </p>
    <p class="reveal mt-6 text-base leading-relaxed text-gray-500 md:text-lg">
      <span class="font-semibold text-black"><span class="text-accent">A</span>rchidi<span class="text-accent">A</span></span> accompagne
      les copropriétés et leurs syndics sur des missions de Diagnostic Technique Global (DTG) et de Projet
      de Plan Pluriannuel de Travaux (PPPT), ainsi que les maisons individuelles et les petits collectifs
      sur des missions de diagnostics architecturaux et énergétiques (DAE).
    </p>
  </section>

  <!-- NOS RÉFÉRENCES : une ligne par type de mission -->
  <ReferencesParLigne titre="Nos références" surtitre="Nos réalisations" lignes={references} />

  <!-- HONORAIRES -->
  <section class="mx-auto max-w-7xl px-6 py-12 md:px-8">
    <p class="reveal mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
      Honoraires
    </p>
    <p class="reveal max-w-3xl text-base leading-relaxed text-gray-500 md:text-lg">
      Nos honoraires pour les diagnostics et études de faisabilité sont établis sur la base d'un{" "}
      <span class="font-semibold text-black">tarif journalier de 800 € HT</span>, dont le montant final
      est déterminé selon le type de bien et la taille du bien.
    </p>
  </section>

  <!-- CERTIFICATIONS & PARTENAIRES -->
  <section class="border-t border-gray-100 bg-gray-50 px-6 py-12 md:px-8">
    <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-2">
      <div class="reveal rounded-md border border-gray-200 bg-white p-8">
        <p class="mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
          Certification / référencement
        </p>
        <ul class="grid grid-cols-2 gap-6">
          {certifications.map((c) => (
            <li class="flex flex-col items-start gap-3">
              <span class="flex h-14 items-center">
                <img src={c.logo} alt={c.nom} class="max-h-14 w-auto max-w-full object-contain" loading="lazy" />
              </span>
              <span class="text-sm font-semibold text-black">{c.nom}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal rounded-md border border-gray-200 bg-white p-8">
        <p class="mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
          Partenaires & qualifications
        </p>
        <ul class="space-y-6">
          <li class="flex flex-col items-start gap-3">
            <span class="flex h-14 items-center">
              <img src="/images/logos/tribu-energie.webp" alt="Tribu Énergie" class="max-h-14 w-auto object-contain" loading="lazy" />
            </span>
            <span class="text-sm font-semibold text-black">Tribu Énergie</span>
          </li>
          <li class="flex items-start gap-3 text-sm font-semibold text-black">
            <span class="mt-1.5 block h-1.5 w-1.5 flex-none bg-accent"></span>
            Qualifications OPQIBI et RGE
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA CONTACT -->
  <section class="mx-auto max-w-7xl px-6 py-12 text-center md:px-8">
    <p class="reveal mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
      Un diagnostic à réaliser ?
    </p>
    <a
      href="/contact"
      class="reveal inline-block bg-black px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-white transition hover:bg-accent"
    >
      Parlons de votre projet →
    </a>
  </section>
</Layout>
