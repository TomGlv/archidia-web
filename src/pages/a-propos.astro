---
import Layout from "../layouts/Layout.astro";

const stats = [
  { value: "+10 ans", label: "En agences d'architecture" },
  { value: "10 ans", label: "Management de projet chez Artelia" },
  { value: "2019", label: "Création d'ArchidiA" },
  { value: "15+", label: "Missions AMO livrées depuis 2019" },
];

const timeline = [
  {
    period: "1996 – 2007",
    text: "Je débute dans de grands cabinets d'architecture, sur des projets d'envergure en France et à l'international — notamment l'agence Arquitectonica au Pérou, l'agence Jean-Paul Viguier à Paris, et l'agence Claude Montfort Architectes, sur plusieurs opérations dont l'Hôtel Hilton de Beyrouth et la rénovation du terminal 1 pour Aéroports de Paris.",
  },
  {
    period: "2007 – 2017",
    text: "Je passe dix ans chez Artelia en management de projet / cheffe de projet, sur des opérations tertiaires et hôtelières de grande envergure : la Tour Generali à La Défense (90 000 m², R+50), l'immeuble Basalte pour la salle des marchés de la Société Générale, l'Hôtel Melia (369 chambres), l'aménagement des sièges parisiens de La Poste.",
  },
  {
    period: "2019",
    text: "J'ai créé ArchidiA, forte de mon expérience professionnelle de plus de 20 ans et du désir de partager mon savoir-faire au sein de ma propre structure.",
  },
  {
    period: "En parallèle",
    text: "Je me forme à la rénovation énergétique et élargis mon champ d'intervention au diagnostic énergétique et à l'accompagnement des copropriétés.",
  },
  {
    period: "Depuis 2026",
    text: "J'étends cette expertise à l'adaptation du logement et à l'accompagnement des personnes âgées, via l'offre Autonomie.",
  },
];
---

<Layout
  title="Claudia Aubert-Paredes, architecte à Bougival | ArchidiA"
  description="Claudia Aubert-Paredes, architecte fondatrice d'ArchidiA : plus de 20 ans d'expérience en agences et en management de projet. Parcours, formation et engagements."
  breadcrumbs={[{ name: "À propos", path: "/a-propos/" }]}
  jsonLd={{
    "@type": "ProfilePage",
    url: "https://archidia.fr/a-propos/",
    mainEntity: { "@id": "https://archidia.fr/a-propos/#claudia" },
  }}
>
  <!-- EN-TÊTE -->
  <section class="px-6 pb-5 pt-8 md:px-8 md:pt-10">
    <div class="mx-auto max-w-7xl">
      <p class="reveal mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
        À propos
      </p>
      <h1 class="titre-1 reveal max-w-4xl text-anthracite">
        Claudia<br />Aubert-Paredes
      </h1>
      <!-- Même grille que la section suivante : la phrase occupe exactement
           la largeur du portrait placé juste en dessous. -->
      <div class="reveal mt-4 grid lg:grid-cols-12 lg:gap-12">
        <p class="mx-auto w-full max-w-sm text-sm font-medium text-gray-500 sm:whitespace-nowrap sm:[text-align-last:justify] lg:col-span-4">
          Architecture et assistance à la maîtrise d'ouvrage
        </p>
      </div>
    </div>
  </section>

  <!-- BIO : PORTRAIT + TEXTE -->
  <section class="px-6 pb-12 pt-0 md:px-8">
    <div class="mx-auto grid max-w-7xl items-start gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Portrait -->
      <div class="reveal mx-auto w-full max-w-sm lg:col-span-4">
        <img
          src="/images/claudia.jpg"
          alt="Claudia Aubert-Paredes, architecte fondatrice d'ArchidiA"
          class="w-full object-cover shadow-sm"
          width="900"
          height="1125"
          loading="lazy"
        />
      </div>

      <!-- Texte -->
      <div class="reveal lg:col-span-8">
        <h2 class="titre-2 mb-5 text-anthracite">
          Parcours
        </h2>
        <div class="space-y-4 text-sm leading-relaxed text-gray-600 md:text-base">
          <p>
            Architecte, fondatrice d'<span class="text-accent">A</span>rchidi<span class="text-accent">A</span>,
            société d'architecture et d'assistance à maîtrise d'ouvrage créée en
            novembre 2019. Diplômée de l'Université Ricardo Palma (Lima, Pérou),
            titulaire d'un CEA (Certificat d'Études Approfondies) en Architecture
            Urbaine, Architecture et Urbanisme de l'École nationale supérieure
            d'architecture de Paris-Belleville (2002-2003).
          </p>
          <p>
            Habilitée à exercer le métier d'architecte en mon nom propre par le
            Ministère de la Culture, je suis inscrite à l'Ordre des architectes
            d'Île-de-France sous le n° 086701.
          </p>
          <p>
            Membre du réseau d'architectes « Architectes et Particuliers », je suis
            agréée et référencée par PasseRenoHabitat et CoachCopro.
          </p>
        </div>

        <!-- Chiffres clés -->
        <dl class="mt-8 grid grid-cols-2 gap-5 border-t border-gray-100 pt-6 sm:grid-cols-4">
          {stats.map((s) => (
            <div>
              <dt class="text-xl font-semibold tracking-tight text-accent md:text-2xl">
                {s.value}
              </dt>
              <dd class="mt-1 text-[10px] font-medium uppercase leading-snug tracking-wide text-gray-500">
                {s.label}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- TIMELINE / FRISE CHRONOLOGIQUE -->
  <section class="border-t border-gray-100 bg-gray-50 px-6 py-12 md:px-8 md:py-12">
    <div class="mx-auto max-w-4xl">
      <p class="reveal mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
        Un parcours d'exigence
      </p>
      <h2 class="titre-2 reveal mb-6 text-anthracite">
        Parcours professionnel
      </h2>

      <ol class="relative ml-2 border-l-2 border-gray-200 md:ml-4">
        {timeline.map((item) => (
          <li class="reveal relative pb-6 pl-7 last:pb-0 md:pl-10">
            <!-- Puce accent -->
            <span
              class="absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-white bg-accent ring-4 ring-accent/15"
              aria-hidden="true"
            ></span>
            <p class="mb-1 text-[11px] font-bold uppercase tracking-widest text-accent">
              {item.period}
            </p>
            <p class="text-sm leading-relaxed text-anthracite md:text-base">
              {item.text}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CITATION -->
  <section class="citation-bande theme-fixe reveal w-full bg-anthracite px-6 py-10 md:py-12">
    <div class="flex items-center justify-center text-center">
      <div class="max-w-3xl">
        <blockquote class="text-lg font-light italic leading-relaxed text-white md:text-2xl">
          « L'exigence, le dynamisme, la rigueur et la créativité autour d'un
          projet — la passion et la volonté d'apporter le meilleur de soi à chaque
          maître d'ouvrage. »
        </blockquote>
        <div class="mx-auto my-6 h-1 w-16 bg-accent"></div>
        <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-white">
          Claudia Aubert-Paredes
        </p>
      </div>
    </div>
  </section>

  <!-- CTA CONTACT -->
  <section class="mx-auto max-w-7xl px-6 py-12 text-center md:px-8">
    <h2 class="titre-2 reveal text-anthracite">
      Envie d'échanger ?
    </h2>
    <a
      href="/contact/"
      class="reveal mt-8 inline-block border-2 border-anthracite px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-anthracite transition hover:bg-anthracite hover:text-white"
    >
      Parlons de votre projet →
    </a>
  </section>
</Layout>
