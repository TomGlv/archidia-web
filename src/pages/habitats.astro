---
import Layout from "../layouts/Layout.astro";
import ApercuRealisations from "../components/ApercuRealisations.astro";

// Frise du processus — étapes chronologiques d'un projet d'habitat
const steps = [
  {
    idx: "01",
    title: "La visite conseil",
    text: "Nos visites conseil s'adressent aux particuliers souhaitant obtenir un premier avis éclairé sur leur projet, pour une durée d'une heure à une heure et demie selon le type de besoin exprimé.",
    livrable: "Rapport selon demande",
    prix: "à partir de 180 € HT",
  },
  {
    idx: "02",
    title: "Les études préliminaires",
    text: "Relevé du site, faisabilité, diagnostic, esquisses présentant plusieurs partis pris possibles, premières visualisations.",
    livrable: "Esquisses",
  },
  {
    idx: "03",
    title: "L'avant-projet",
    text: "Réalisation des plans, coupes et façades avec les dimensions de l'ouvrage, selon la solution retenue, aspect, surfaces et nature des matériaux.",
    livrable: "Dossiers plans d'avant-projet",
  },
  {
    idx: "04",
    title: "Les autorisations d'urbanisme",
    text: "Constitution et dépôt du dossier de permis de construire ou de déclaration préalable, démarches auprès des services concernés.",
    livrable: "Dossier déposé & suivi de l'instruction",
  },
  {
    idx: "05",
    title: "La conception détaillée",
    text: "Choix des matériaux et finitions, plans d'exécution, coupes et façades, pièces techniques nécessaires à la consultation des entreprises.",
    livrable: "Dossier de consultation des entreprises",
  },
  {
    idx: "06",
    title: "Le suivi de chantier",
    text: "Consultation et choix des entreprises, suivi hebdomadaire du chantier, contrôle qualité et budgétaire, jusqu'à la réception des travaux.",
    livrable: "Comptes rendus & réception des travaux",
  },
];
---

<Layout
  title="Habitats"
  description="Construction, extension et rénovation de votre habitat : maîtrise d'œuvre et suivi de chantier de A à Z, de la visite conseil à la réception des travaux."
  breadcrumbs={[{ name: "Habitats", path: "/habitats/" }]}
  jsonLd={{
    "@type": "Service",
    name: "Maîtrise d'œuvre d'habitats : construction, rénovation, extension",
    serviceType: "Habitats",
    provider: { "@id": "https://archidia.fr/#organisation" },
    areaServed: { "@type": "AdministrativeArea", name: "Île-de-France" },
    url: "https://archidia.fr/habitats/",
  }}
>
  <!-- HERO DE SECTION -->
  <header class="relative flex h-[62vh] min-h-[400px] items-center overflow-hidden bg-[#20221f]">
    <img
      src="/images/home-intro.jpg"
      alt="Projet d'habitat accompagné par ArchidiA"
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/30"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 md:px-8">
      <p class="mb-5 text-[10px] font-bold uppercase tracking-[0.4em] text-accent">
        Habitats
      </p>
      <h1 class="mb-6 text-4xl font-normal uppercase leading-[1.05] tracking-tight text-white drop-shadow-lg sm:text-5xl md:text-6xl">
        Construire, agrandir,<br />rénover.
      </h1>
      <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-gray-300 md:text-xs">
        Constructions · Extensions · <span class="text-accent">Rénovations</span>
      </p>
    </div>
  </header>

  <div class="bg-[#fafafa]">
  <!-- INTRO -->
  <section class="mx-auto max-w-3xl px-6 py-12 text-center md:py-12">
    <p class="reveal text-xl leading-relaxed text-gray-700 md:text-2xl">
      Ce sont des <span class="font-semibold text-black">projets de vie</span>, pas
      seulement des chantiers.
    </p>
    <p class="reveal mt-6 text-base leading-relaxed text-gray-500 md:text-lg">
      Chaque maison a une histoire — celle d'une famille qui s'agrandit, d'un lieu
      qui se transforme, d'un regard neuf porté sur un espace déjà habité.
    </p>
  </section>

  <!-- DÉROULÉ D'UN PROJET : grille d'étapes + point d'arrivée -->
  <section class="px-6 py-12 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-8">
        <p class="reveal mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
          Notre méthode
        </p>
        <h2 class="reveal text-3xl font-normal uppercase tracking-tight text-anthracite md:text-4xl">
          Le déroulé d'un projet, étape par étape
        </h2>
      </div>

      <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {steps.map((s) => (
          <li class="reveal flex h-full flex-col border border-gray-200 bg-white p-6 transition hover:border-accent">
            <div class="mb-4 flex items-center gap-4">
              <span class="text-3xl font-light leading-none text-accent">{s.idx}</span>
              <span class="h-px flex-1 bg-gray-200" aria-hidden="true"></span>
            </div>
            <h3 class="text-base font-normal uppercase tracking-tight text-anthracite md:text-lg">
              {s.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-500">{s.text}</p>
            <div class="mt-auto pt-5">
              <div class="border-t border-gray-100 pt-4">
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">Livrable</p>
                <p class="mt-1 text-sm text-anthracite">{s.livrable}</p>
                {s.prix && (
                  <p class="mt-3 inline-block bg-accent/10 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-accent">
                    {s.prix}
                  </p>
                )}
              </div>
            </div>
          </li>
        ))}
      </ol>

      <!-- Point d'arrivée -->
      <div class="reveal mt-5 flex flex-col gap-6 bg-anthracite px-6 py-6 text-white md:flex-row md:items-center md:justify-between md:px-8">
        <div class="flex items-center gap-5">
          <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full border-2 border-accent text-accent" aria-hidden="true">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/></svg>
          </span>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.25em] text-accent">Point d'arrivée</p>
            <p class="mt-1 text-xl font-normal uppercase tracking-tight md:text-2xl">Votre nouvel habitat</p>
          </div>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-gray-200 md:text-right">
          Hors visite conseil, chaque étape fait l'objet d'un devis à la demande,
          établi sur une base de <span class="font-semibold text-white">800 € HT/jour</span>.
        </p>
      </div>
    </div>
  </section>

  <ApercuRealisations categorie="Maison individuelle" titre="Nos projets d'habitat" />

  <!-- CTA CONTACT -->
  <section class="mx-auto max-w-7xl px-6 py-12 text-center md:px-8">
    <h2 class="reveal text-3xl font-normal uppercase tracking-tight text-anthracite md:text-4xl">
      Un projet d'habitat ?
    </h2>
    <p class="reveal mx-auto mt-5 max-w-xl text-base leading-relaxed text-gray-500">
      De la première esquisse au suivi de chantier, l'agence vous accompagne à
      chaque étape de votre projet.
    </p>
    <a
      href="/contact"
      class="reveal mt-8 inline-block border-2 border-black px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-black transition hover:bg-black hover:text-white"
    >
      Parlons de votre projet →
    </a>
  </section>
  </div>
</Layout>
