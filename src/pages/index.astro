---
import Layout from "../layouts/Layout.astro";
import Piliers from "../components/Piliers.astro";
import HeroImage from "../components/HeroImage.astro";
import heroAccueil from "../assets/hero-accueil.jpg";

const pillars = [
  {
    idx: "01",
    title: "AMO & MOE",
    text: "Piloter un projet de bureaux, d'hôtellerie ou de logements collectifs pour le compte d'un maître d'ouvrage, de la conception à la réception.",
    href: "/amo-moe/",
  },
  {
    idx: "02",
    title: "Diagnostics & copropriétés",
    text: "Diagnostic technique global (DTG), plan pluriannuel de travaux (PPPT) et diagnostics de maisons (DAE) : l'accompagnement des copropriétés et des particuliers.",
    href: "/diagnostics/",
  },
  {
    idx: "03",
    title: "Habitats",
    text: "Construire, agrandir ou rénover une maison, avec la rigueur d'un suivi de chantier de A à Z.",
    href: "/habitats/",
  },
  {
    idx: "04",
    title: "Autonomie",
    text: "Adapter un logement pour bien vieillir chez soi, avec l'accompagnement MaPrimeAdapt'.",
    href: "/autonomie/",
  },
];
---

<Layout
  title="Architecte à Bougival (78) : AMO, MOE, copropriétés | ArchidiA"
  description="ArchidiA, architecte à Bougival (Yvelines) : AMO et maîtrise d'œuvre, DTG et PPPT de copropriété, extension et rénovation de maison, adaptation du logement."
>
  <!-- HERO -->
  <header class="theme-fixe relative flex h-[78vh] min-h-[440px] items-center overflow-hidden bg-[#20221f]">
    <HeroImage
      src={heroAccueil}
      alt="Toiture-terrasse en bois et façade vitrée d'un immeuble de bureaux"
      class="absolute inset-0 h-full w-full object-cover opacity-70"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/25"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 md:px-8">
      <h1 class="mb-6 text-white drop-shadow-lg">
        <span class="mb-4 block text-[11px] font-bold uppercase tracking-[0.35em] text-gray-200 md:text-xs">
          Architecte à Bougival · Yvelines & Île-de-France
        </span>
        <span class="titre-1 block">Votre projet,<br />notre exigence.</span>
      </h1>
      <p class="text-[10px] font-bold uppercase tracking-[0.4em] text-gray-300 md:text-xs">
        AMO · MOE · <span class="text-accent">Expertise technique</span>
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="/contact/"
          class="inline-block bg-accent px-8 py-4 text-center text-[10px] font-bold uppercase tracking-widest text-white transition hover:bg-white hover:text-anthracite"
        >
          Parlons de votre projet →
        </a>
        <a
          href="tel:+33614600663"
          class="inline-block border-2 border-white px-8 py-4 text-center text-[10px] font-bold uppercase tracking-widest text-white transition hover:bg-white hover:text-anthracite"
        >
          Appeler le 06 14 60 06 63
        </a>
      </div>
    </div>
  </header>

  <!-- NOTRE APPROCHE -->
  <section class="mx-auto max-w-3xl px-6 py-12 text-center md:py-14">
    <p class="reveal mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
      Notre approche
    </p>
    <p class="reveal text-xl leading-relaxed text-anthracite md:text-2xl">
      Chez <span class="font-semibold text-anthracite"><span class="text-accent">A</span>rchidi<span class="text-accent">A</span></span>,
      l'agence accompagne chaque maître d'ouvrage avec la même rigueur, du premier
      trait jusqu'à la réception des travaux.
    </p>
    <p class="reveal mt-6 text-base leading-relaxed text-gray-500 md:text-lg">
      AMO, diagnostics, accompagnement des copropriétés et habitats,
      adaptation des logements seniors — une pluralité de missions portées par une
      même conviction : chaque projet, professionnel ou particulier, répond à la même
      exigence de qualité.
    </p>
    <a
      href="/realisations/"
      class="reveal mt-8 inline-block bg-anthracite px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-white transition hover:bg-accent"
    >
      Découvrir nos réalisations →
    </a>
  </section>

  <!-- PILIERS / SERVICES -->
  <section class="border-t border-gray-100 px-6 py-12 md:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="titre-2 reveal mb-8 text-anthracite">
        Nos missions d'architecte en Île-de-France
      </h2>
      <Piliers items={pillars} />
    </div>
  </section>

  <!-- ANCRAGE LOCAL -->
  <section class="border-t border-gray-100 bg-gray-50 px-6 py-12 md:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">Bougival &amp; ouest parisien</p>
        <h2 class="titre-2 text-anthracite">Une architecte installée à Bougival</h2>
      </div>
      <div class="reveal space-y-4 text-base leading-relaxed text-gray-600">
        <p>
          L'agence est installée à Bougival, dans les Yvelines. Claudia Aubert-Paredes,
          architecte inscrite à l'Ordre des architectes d'Île-de-France, y accompagne
          particuliers, copropriétés et maîtres d'ouvrage professionnels, avec plus de
          20 ans d'expérience en agences d'architecture et en management de projet.
        </p>
        <p>
          Nous intervenons principalement dans l'ouest parisien — Bougival, Rueil-Malmaison,
          La Celle-Saint-Cloud, Louveciennes, Croissy-sur-Seine, Saint-Germain-en-Laye,
          Versailles, Boulogne-Billancourt — ainsi qu'à Paris et dans le reste de
          l'Île-de-France : diagnostics de copropriétés à Paris, maisons rénovées ou agrandies
          à Bougival et Rueil-Malmaison, immeubles de bureaux et hôtels pour des maîtres
          d'ouvrage professionnels.
        </p>
        <p>
          <a href="/realisations/copropriete-la-jonchere/" class="font-semibold text-anthracite underline decoration-accent underline-offset-4 hover:text-accent">DTG de la copropriété La Jonchère</a>{" "}
          et <a href="/realisations/maison-bougival/" class="font-semibold text-anthracite underline decoration-accent underline-offset-4 hover:text-accent">construction et extension d'une maison</a>{" "}
          à Bougival : quelques exemples de projets menés près de chez vous.
        </p>
      </div>
    </div>
  </section>

  <!-- CITATION -->
  <section class="citation-bande theme-fixe reveal w-full bg-anthracite px-6 py-10 md:py-12">
    <div class="flex items-center justify-center text-center">
      <div class="max-w-3xl">
        <blockquote class="text-2xl font-light italic leading-relaxed text-white md:text-3xl">
          « Je conçois l'architecture comme un dialogue permanent entre l'intérieur
          et l'extérieur, où chaque espace se façonne autour de celui qui l'habite,
          et où la lumière est une quête perpétuelle. »
        </blockquote>
        <div class="mx-auto mt-8 h-1 w-20 bg-accent"></div>
      </div>
    </div>
  </section>

  <!-- CTA CONTACT -->
  <section class="mx-auto max-w-7xl px-6 py-12 text-center md:px-8">
    <h2 class="titre-2 reveal text-anthracite">
      Un projet en tête ?
    </h2>
    <a
      href="/contact/"
      class="reveal mt-8 inline-block border-2 border-anthracite px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-anthracite transition hover:bg-anthracite hover:text-white"
    >
      Parlons de votre projet →
    </a>
  </section>
</Layout>
