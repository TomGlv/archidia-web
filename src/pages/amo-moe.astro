---
import Layout from "../layouts/Layout.astro";
import ReferencesParLigne from "../components/ReferencesParLigne.astro";
import { getLigne, lienRealisations } from "../lib/sanity";
import Piliers from "../components/Piliers.astro";
import HeroImage from "../components/HeroImage.astro";
import heroAmo from "../assets/hero-amo.jpg";

// ── Secteurs d'intervention (AMO / MOE) ─────────────────────────────
const sectors = [
  {
    idx: "01",
    title: "Bureaux & patrimoine",
    text: "Rénovation, restructuration et réception d'immeubles tertiaires, du socle aux façades, y compris sur bâtiments protégés.",
    href: "/realisations/?cat=amo-moe&secteur=bureaux-patrimoine",
  },
  {
    idx: "02",
    title: "Hôtellerie",
    text: "Conduite d'opération et suivi de travaux d'hôtels : chambres, lobby, restauration, spa et espaces communs.",
    href: "/realisations/?cat=amo-moe&secteur=hotellerie",
  },
  {
    idx: "03",
    title: "Logements collectifs & résidences",
    text: "Livraison de logements en accession, de résidences seniors et de résidences de tourisme haut de gamme.",
    href: "/realisations/?cat=amo-moe&secteur=logements-collectifs-residences",
  },
];

// Quelques réalisations : une ligne de 3 projets par secteur
const references = await Promise.all(
  ["Bureaux & patrimoine", "Logements collectifs & résidences", "Hôtellerie"].map(async (secteur) => ({
    libelle: secteur,
    projets: await getLigne("AMO / MOE", (p) => p.secteur === secteur),
    href: lienRealisations("AMO / MOE", secteur),
  })),
);
---

<Layout
  title="AMO & maîtrise d'œuvre en Île-de-France | ArchidiA"
  description="Assistance à maîtrise d'ouvrage (AMO) et maîtrise d'œuvre pour bureaux, hôtels et logements collectifs en Île-de-France, de la conception à la réception."
  breadcrumbs={[{ name: "AMO / MOE", path: "/amo-moe/" }]}
  jsonLd={{
    "@type": "Service",
    "@id": "https://archidia.fr/amo-moe/#service",
    name: "Assistance à maîtrise d'ouvrage et maîtrise d'œuvre",
    description: "AMO et maîtrise d'œuvre pour des projets de bureaux, d'hôtellerie et de logements collectifs, de la conception à la réception des travaux.",
    serviceType: "AMO / MOE",
    provider: { "@id": "https://archidia.fr/#organisation" },
    areaServed: [
      { "@type": "AdministrativeArea", name: "Yvelines" },
      { "@type": "AdministrativeArea", name: "Hauts-de-Seine" },
      { "@type": "City", name: "Paris" },
      { "@type": "AdministrativeArea", name: "Île-de-France" },
    ],
    url: "https://archidia.fr/amo-moe/",
  }}
>
  <!-- HERO / BANDEAU TITRE -->
  <header class="theme-fixe relative flex h-[62vh] min-h-[400px] items-center overflow-hidden bg-[#20221f]">
    <HeroImage
      src={heroAmo}
      alt="Terrasse en bois et façade vitrée d'un immeuble de bureaux"
      class="absolute inset-0 h-full w-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/30"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 md:px-8">
      <p class="mb-5 text-[10px] font-bold uppercase tracking-[0.4em] text-accent md:text-xs">
        AMO & MOE
      </p>
      <h1 class="titre-1 mb-6 text-white drop-shadow-lg">
        Assistance à la maîtrise d'ouvrage<br class="hidden sm:block" /> & maîtrise d'œuvre
      </h1>
      <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-gray-300 md:text-xs">
        Bureaux · Hôtellerie · <span class="text-accent">Logements collectifs & résidences</span>
      </p>
    </div>
  </header>

  <!-- INTRODUCTION / DOUBLE EXPERTISE -->
  <section class="mx-auto max-w-3xl px-6 py-12 text-center md:py-14">
    <p class="reveal mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-accent">
      Une double expertise AMO & MOE
    </p>
    <p class="reveal text-xl leading-relaxed text-anthracite md:text-2xl">
      Une mission d'AMO ou de MOE réussie suppose de maîtriser à la fois les enjeux
      du maître d'ouvrage, les contraintes du projet et les réalités du chantier.
    </p>
    <p class="reveal mt-6 text-base leading-relaxed text-gray-500 md:text-lg">
      Après dix ans passés dans des agences d'architecture et dix ans de management
      de projet à côté de la maîtrise d'ouvrage, sur des opérations tertiaires et
      hôtelières de grande envergure, l'agence met cette double expertise — AMO et
      MOE — au service de vos projets, avec une pratique particulièrement développée
      dans le tertiaire et l'hôtellerie.
    </p>
  </section>

  <!-- SECTEURS D'INTERVENTION -->
  <section class="border-t border-gray-100 px-6 py-12 md:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="titre-2 reveal mb-8 text-anthracite">
        Nos secteurs d'intervention
      </h2>
      <Piliers items={sectors} cta="Voir les projets →" class="md:grid-cols-3" />
    </div>
  </section>

  <ReferencesParLigne titre="Quelques réalisations" lignes={references} class="bg-gray-50" />

  <!-- CTA CONTACT -->
  <section class="mx-auto max-w-7xl px-6 py-12 text-center md:px-8">
    <h2 class="titre-2 reveal text-anthracite">
      Un projet à piloter ?
    </h2>
    <p class="reveal mt-5 text-base leading-relaxed text-gray-500 md:text-lg">
      Parlons de votre projet de bureaux, d'hôtellerie ou de logements.
    </p>
    <div class="reveal mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="/contact/"
        class="inline-block bg-anthracite px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-white transition hover:bg-accent"
      >
        Parlons de votre projet →
      </a>
      <a
        href="/realisations/?cat=amo-moe"
        class="inline-block border-2 border-anthracite px-10 py-5 text-[10px] font-bold uppercase tracking-widest text-anthracite transition hover:bg-anthracite hover:text-white"
      >
        Voir nos réalisations →
      </a>
    </div>
  </section>
</Layout>
