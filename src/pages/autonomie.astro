---
import Layout from "../layouts/Layout.astro";
import ApercuRealisations from "../components/ApercuRealisations.astro";
import Piliers from "../components/Piliers.astro";
import HeroImage from "../components/HeroImage.astro";
import heroAutonomie from "../assets/hero-autonomie.jpg";

const steps = [
  {
    idx: "01",
    title: "Diagnostic du logement",
    text: "Visite à domicile, repérage pièce par pièce des points de vigilance et échange sur les besoins et les habitudes de vie.",
  },
  {
    idx: "02",
    title: "Plan d'aménagement",
    text: "Propositions d'aménagement adaptées, et orientation vers les dispositifs d'aide existants (MaPrimeAdapt', crédit d'impôt, aides des caisses de retraite) selon votre situation.",
  },
  {
    idx: "03",
    title: "Suivi de chantier",
    text: "Coordination des intervenants, contrôle de la qualité d'exécution et réception des travaux aux côtés du bénéficiaire.",
  },
];
---

<Layout
  title="Adaptation du logement senior et MaPrimeAdapt' (78) | ArchidiA"
  description="Adapter le logement d'un proche pour bien vieillir chez soi : diagnostic à domicile, aménagements, aide MaPrimeAdapt' et suivi des travaux en Île-de-France."
  breadcrumbs={[{ name: "Autonomie", path: "/autonomie/" }]}
  jsonLd={{
    "@type": "Service",
    "@id": "https://archidia.fr/autonomie/#service",
    name: "Adaptation du logement pour le maintien à domicile",
    description: "Diagnostic du logement, plan d'aménagement, orientation vers les aides (dont MaPrimeAdapt') et suivi des travaux d'adaptation.",
    serviceType: "Autonomie",
    provider: { "@id": "https://archidia.fr/#organisation" },
    areaServed: [
      { "@type": "AdministrativeArea", name: "Yvelines" },
      { "@type": "AdministrativeArea", name: "Hauts-de-Seine" },
      { "@type": "City", name: "Paris" },
      { "@type": "AdministrativeArea", name: "Île-de-France" },
    ],
    url: "https://archidia.fr/autonomie/",
  }}
>
  <!-- HERO -->
  <header class="theme-fixe relative flex h-[72vh] min-h-[420px] items-center overflow-hidden bg-[#20221f]">
    <HeroImage
      src={heroAutonomie}
      alt="Douche de plain-pied adaptée avec siège rabattable et barres d'appui"
      class="absolute inset-0 h-full w-full object-cover opacity-70"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/30"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 md:px-8">
      <h1 class="titre-1 mb-6 text-white drop-shadow-lg">
        Adapter le logement,<br />préserver l'autonomie
      </h1>
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-gray-300 md:text-sm">
        Diagnostic · Conseil aménagement · <span class="text-accent">Suivi de travaux</span>
      </p>
    </div>
  </header>

  <!-- INTRODUCTION -->
  <section class="mx-auto max-w-3xl px-6 py-12 text-center md:py-12">
    <p class="reveal text-xl leading-relaxed text-anthracite md:text-2xl md:leading-relaxed">
      Chez <span class="font-semibold text-anthracite"><span class="text-accent">A</span>rchidi<span class="text-accent">A</span></span>,
      nous accompagnons les familles qui souhaitent que leurs proches continuent à{" "}
      <span class="font-semibold text-anthracite">bien vivre chez eux</span>, avec la même
      exigence technique que pour nos missions de maîtrise d'œuvre et d'assistance à
      maîtrise d'ouvrage.
    </p>
  </section>

  <ApercuRealisations categorie="Autonomie" titre="Les résidences seniors" surtitre="" class="bg-gray-50" />

  <!-- POUR LES PARTICULIERS / ÉTAPES -->
  <section class="px-6 py-12 md:px-8 md:py-12">
    <div class="mx-auto max-w-6xl">
      <p class="reveal mb-4 text-[11px] font-bold uppercase tracking-[0.3em] text-accent">
        Pour les particuliers
      </p>
      <h2 class="titre-2 reveal mb-8 text-anthracite">
        Ce que nous pouvons faire<br class="hidden sm:block" /> dans votre logement
      </h2>
      <Piliers items={steps} class="md:grid-cols-3" />
    </div>
  </section>

  <!-- MAPRIMEADAPT' -->
  <section class="border-t border-gray-100 bg-gray-50 px-6 py-12 md:px-8 md:py-12">
    <div class="mx-auto max-w-3xl text-center">
      <p class="reveal mb-4 text-[11px] font-bold uppercase tracking-[0.3em] text-accent">
        Les aides possibles
      </p>
      <p class="reveal text-xl leading-relaxed text-anthracite md:text-2xl md:leading-relaxed">
        Selon votre âge, votre niveau de ressources et votre situation d'autonomie,
        plusieurs dispositifs d'aide peuvent exister — dont{" "}
        <span class="font-semibold text-anthracite">MaPrimeAdapt'</span>. Que vous soyez
        éligible ou non à ces aides, <span class="font-semibold text-anthracite"><span class="text-accent">A</span>rchidi<span class="text-accent">A</span></span>{" "}
        vous accompagne dans votre projet d'adaptation.
      </p>
      <p class="reveal mt-8 text-base leading-relaxed text-gray-500 md:text-lg">
        Un premier échange téléphonique, gratuit, permet de faire le point sur votre
        situation et d'envisager une visite conseil à domicile.
      </p>
      <a
        href="/contact/"
        class="reveal mt-10 inline-block bg-anthracite px-10 py-5 text-xs font-bold uppercase tracking-widest text-white transition hover:bg-accent"
      >
        Être recontacté →
      </a>
    </div>
  </section>

  <!-- CITATION -->
  <section class="citation-bande theme-fixe reveal w-full bg-anthracite px-6 py-10 text-center md:py-12">
    <div class="mx-auto max-w-3xl">
      <blockquote class="text-2xl font-light italic leading-relaxed text-white md:text-3xl md:leading-relaxed">
        « Adapter un logement, c'est permettre à chacun de continuer à habiter
        pleinement chez soi. »
      </blockquote>
      <div class="mx-auto mt-8 h-1 w-20 bg-accent"></div>
    </div>
  </section>
</Layout>
